# =========================================================================== #
#  ComplyTrack — environment configuration
#
#  Copy this file and edit it:
#     Local (no Docker):   cp .env.example backend/.env
#     Docker Compose:      cp .env.example .env
#
#  Every name below is read by backend/app/core/config.py (pydantic-settings).
#  Names are case-insensitive; list values use JSON syntax, e.g.
#  CORS_ORIGINS=["https://complytrack.example.in"].
#
#  !! NEVER commit a filled-in .env — it is in .gitignore. !!
#  Generate the secret with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# =========================================================================== #

# --- identity -------------------------------------------------------------- #
APP_NAME=ComplyTrack
# development | staging | production
ENVIRONMENT=development
# Set DEBUG=false in production — never expose traces to users.
DEBUG=true

# --- persistence ----------------------------------------------------------- #
# Leave DATABASE_URL commented out and the app uses backend/complytrack.db
# (SQLite, absolute path computed from the backend folder — zero setup).
# DATABASE_URL=sqlite:///C:/data/comp/factory_compliance/backend/complytrack.db
#
# PostgreSQL in production. Requires the psycopg 3 driver:
#     pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://complytrack:CHANGE_ME@db:5432/complytrack
#
# Where uploaded certificates/returns are stored. Leave commented for the
# default (backend/storage). In production use an absolute path outside the
# code directory so it survives redeploys.
# STORAGE_DIR=/var/lib/complytrack/storage

# --- authentication & session security ------------------------------------- #
# REPLACE THIS. One-liner: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# --- Microsoft Entra ID (Azure AD) SSO — optional -------------------------- #
# Leave blank to run local-email/password sign-in only (with TOTP MFA).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback

# --- email / SMTP ---------------------------------------------------------- #
# Leave SMTP_HOST blank to spool mail as .eml files in MAIL_OUTBOX_DIR instead
# of sending — useful for demos and for testing reminders offline.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=complytrack@example.com
SMTP_USE_TLS=true
# Leave commented for the default (backend/outbox).
# MAIL_OUTBOX_DIR=/var/lib/complytrack/outbox

# --- reminder / escalation engine ------------------------------------------ #
SCHEDULER_ENABLED=true
# Daily job time, in IST (Asia/Kolkata). 07:00 is the PRD default.
SCHEDULER_HOUR_IST=7
QUIET_HOURS_START=21
QUIET_HOURS_END=7
# Reminder offsets, in days before the anchor date. JSON list.
DEFAULT_REMINDER_OFFSETS=[90, 60, 30, 15, 7, 3, 1, 0]
# After expiry, repeat every N days until the instance is closed (AC-8).
POST_EXPIRY_FREQUENCY_DAYS=2

# --- first-run behaviour --------------------------------------------------- #
# seeding is idempotent — reference data loads once and is then left alone.
SEED_ON_STARTUP=true
# Demo users + a sample register. Set to false for a clean production start.
SEED_DEMO_DATA=true

# --- support / packaging --------------------------------------------------- #
SUPPORT_EMAIL=compliance.helpdesk@example.invalid
# Where the built SPA lives. Leave commented for the default
# (../frontend/dist relative to the backend folder). The API serves the SPA from
# here when the folder exists (single-origin deployment). Point at a nonexistent
# path when nginx serves the UI separately, as in docker-compose.yml.
# FRONTEND_DIST_DIR=/srv/complytrack/frontend/dist

# --- uploads --------------------------------------------------------------- #
MAX_UPLOAD_MB=25
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=[".pdf", ".jpg", ".jpeg", ".png", ".docx", ".xlsx", ".doc", ".xls"]

# --- CORS ------------------------------------------------------------------ #
# Browser origins allowed to call the API directly (Vite dev server, etc.).
# In the nginx/Compose deployment the UI is same-origin, so this can stay small.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]

# --------------------------------------------------------------------------- #
# Compose-only variables (used by docker-compose.yml, not by the app itself).
# --------------------------------------------------------------------------- #
POSTGRES_USER=complytrack
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=complytrack
BACKEND_PORT=8000
FRONTEND_PORT=8080
